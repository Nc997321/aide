[
  {
    "name": "results and failures are typed; unknown methods are refused",
    "steps": [
      { "send": { "type": "hello", "versions": [1] } },
      { "expect": { "type": "hello_ok" } },
      { "send": { "type": "auth", "token": "test-token" } },
      { "expect": { "type": "authed" } },
      { "send": { "type": "call", "id": 1, "method": "set_model", "params": { "sessionId": "s1", "model": "nope" } } },
      { "expect": { "type": "error", "id": 1, "code": "failed", "message": "model not found" } },
      { "send": { "type": "call", "id": 2, "method": "write_file_content", "params": { "path": "/etc/passwd", "content": "" } } },
      { "expect": { "type": "error", "id": 2, "code": "unknown_method" } },
      { "send": { "type": "call", "id": 3, "method": "link.nonsense", "params": {} } },
      { "expect": { "type": "error", "id": 3, "code": "unknown_method" } },
      { "send": { "type": "call", "id": 4, "method": "list_sessions" } },
      { "expect": { "type": "result", "id": 4, "value": ["s1", "s2"] } },
      { "send": { "type": "call", "id": 5, "method": "list_sessions", "params": [1, 2] } },
      { "expect": { "type": "error", "id": 5, "code": "invalid_params" } }
    ]
  },
  {
    "name": "send_message without a permissionMode gets the Host's remote default; an explicit one wins",
    "steps": [
      { "send": { "type": "hello", "versions": [1] } },
      { "expect": { "type": "hello_ok" } },
      { "send": { "type": "auth", "token": "test-token" } },
      { "expect": { "type": "authed" } },
      { "send": { "type": "call", "id": 1, "method": "send_message", "params": { "sessionId": "s1", "prompt": "hi" } } },
      { "expect": { "type": "result", "id": 1, "value": { "sessionId": "s1", "prompt": "hi", "permissionMode": "acceptEdits" } } },
      { "send": { "type": "call", "id": 2, "method": "send_message", "params": { "sessionId": "s1", "prompt": "hi", "permissionMode": "plan" } } },
      { "expect": { "type": "result", "id": 2, "value": { "permissionMode": "plan" } } },
      { "send": { "type": "call", "id": 3, "method": "send_message", "params": { "sessionId": "s1", "prompt": "hi", "permissionMode": "default" } } },
      { "expect": { "type": "result", "id": 3, "value": { "permissionMode": "manual" } } }
    ]
  },
  {
    "name": "calls run concurrently: a slow call does not block a fast one, answers arrive by id",
    "steps": [
      { "send": { "type": "hello", "versions": [1] } },
      { "expect": { "type": "hello_ok" } },
      { "send": { "type": "auth", "token": "test-token" } },
      { "expect": { "type": "authed" } },
      { "send": { "type": "call", "id": 1, "method": "load_messages", "params": { "sessionId": "s1" } } },
      { "send": { "type": "call", "id": 2, "method": "list_sessions", "params": {} } },
      { "expect": { "type": "result", "id": 2, "value": ["s1", "s2"] } },
      { "expect": { "type": "result", "id": 1, "value": ["slow"] } }
    ]
  },
  {
    "name": "link.describe is the machine-readable catalog",
    "steps": [
      { "send": { "type": "hello", "versions": [1] } },
      { "expect": { "type": "hello_ok" } },
      { "send": { "type": "auth", "token": "test-token" } },
      { "expect": { "type": "authed" } },
      { "send": { "type": "call", "id": 1, "method": "link.describe", "params": {} } },
      { "expect": { "type": "result", "id": 1, "value": {
          "version": 1,
          "groups": "<any>",
          "link_methods": ["link.describe", "link.unpair"],
          "events": [
            { "name": "chat-event", "session_routed": true },
            { "name": "system-notification", "session_routed": false },
            { "name": "permissions-changed", "session_routed": false }
          ] } } }
    ]
  },
  {
    "name": "link.unpair: the device removes itself; the Host answers, then ends the connection",
    "steps": [
      { "send": { "type": "hello", "versions": [1] } },
      { "expect": { "type": "hello_ok" } },
      { "send": { "type": "auth", "token": "test-token" } },
      { "expect": { "type": "authed" } },
      { "send": { "type": "call", "id": 1, "method": "link.unpair", "params": {} } },
      { "expect": { "type": "result", "id": 1, "value": null } },
      { "expect": { "type": "bye", "code": "revoked" } },
      { "expect_closed": true }
    ]
  }
]
