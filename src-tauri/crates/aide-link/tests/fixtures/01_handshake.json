[
  {
    "name": "hello negotiates the highest common version and describes the Host",
    "steps": [
      { "send": { "type": "hello", "versions": [1, 99], "client": { "name": "pwa", "version": "1", "platform": "web" } } },
      { "expect": { "type": "hello_ok", "version": 1,
                    "host": { "id": "dev-1", "name": "fake-host", "os": "linux", "arch": "<string>", "version": "<string>" },
                    "auth": ["pair", "token"],
                    "limits": { "max_frame_bytes": "<number>", "max_in_flight": "<number>" } } }
    ]
  },
  {
    "name": "no common version: hello_err lists what the Host supports, then the Host hangs up",
    "steps": [
      { "send": { "type": "hello", "versions": [99] } },
      { "expect": { "type": "hello_err", "code": "unsupported_version", "supported": [1] } },
      { "expect_closed": true }
    ]
  },
  {
    "name": "the first frame must be hello",
    "steps": [
      { "send": { "type": "ping", "n": 1 } },
      { "expect": { "type": "bye", "code": "protocol_error", "message": "<string>" } },
      { "expect_closed": true }
    ]
  },
  {
    "name": "garbage before hello is a protocol error",
    "steps": [
      { "send": "not json at all" },
      { "expect": { "type": "bye", "code": "protocol_error" } },
      { "expect_closed": true }
    ]
  },
  {
    "name": "ping is answered with the same n; a second hello is rejected but harmless",
    "steps": [
      { "send": { "type": "hello", "versions": [1] } },
      { "expect": { "type": "hello_ok" } },
      { "send": { "type": "ping", "n": 41 } },
      { "expect": { "type": "pong", "n": 41 } },
      { "send": { "type": "hello", "versions": [1] } },
      { "expect": { "type": "error", "code": "invalid_frame" } },
      { "send": { "type": "ping", "n": 42 } },
      { "expect": { "type": "pong", "n": 42 } }
    ]
  },
  {
    "name": "an idle client is pinged, and a silent one is dropped",
    "steps": [
      { "send": { "type": "hello", "versions": [1] } },
      { "expect": { "type": "hello_ok" } },
      { "tick_secs": 30 },
      { "expect": { "type": "ping", "n": "<number>" } },
      { "tick_secs": 80 },
      { "expect": { "type": "bye", "code": "timeout" } },
      { "expect_closed": true }
    ]
  }
]
