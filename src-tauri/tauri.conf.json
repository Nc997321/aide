{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/main/tauri/config.schema.json",
  "productName": "Aide",
  "version": "1.2.0",
  "identifier": "com.aide.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm build:sidecar:dev && pnpm build:remote-kit:dev && pnpm dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../agent-sidecar/dist/aide-agent*": "agent-runtime/",
      "remote-kit/*": "remote-kit/",
    "resources/lsp-install-guide.html": "lsp-install-guide.html",
    "resources/lsp/lombok.jar": "lsp/lombok.jar",
    "resources/vc-redist/vc_redist.x64.exe": "vc-redist/vc_redist.x64.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
