{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/main/tauri/config.schema.json",
  "productName": "Aide",
  "version": "0.8.0",
  "identifier": "com.aide.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../agent-sidecar/dist/aide-agent.exe": "agent-runtime/aide-agent.exe",
      "../agent-sidecar/node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/claude.exe": "agent-runtime/claude.exe",
      "../agent-sidecar/default-models.json": "agent-runtime/default-models.json",
      "../agent-sidecar/default-permission-modes.json": "agent-runtime/default-permission-modes.json",
      "resources/provider-catalog.json": "agent-runtime/provider-catalog.json",
    "resources/codegraph-model/model.onnx": "codegraph-model/model.onnx",
    "resources/codegraph-model/tokenizer.json": "codegraph-model/tokenizer.json",
    "resources/codegraph-model/config.json": "codegraph-model/config.json",
    "resources/codegraph-model/special_tokens_map.json": "codegraph-model/special_tokens_map.json",
    "resources/codegraph-model/tokenizer_config.json": "codegraph-model/tokenizer_config.json",
    "resources/lsp-install-guide.html": "lsp-install-guide.html",
    "resources/lsp/lombok.jar": "lsp/lombok.jar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
