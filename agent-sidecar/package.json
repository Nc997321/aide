{
  "name": "agent-sidecar",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/runtime.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/runtime.js --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "build:exe": "bun build --compile dist/runtime.js --outfile dist/aide-agent.exe --windows-icon=../src-tauri/icons/icon.ico --windows-title=Aide-Agent --windows-publisher=Aide --windows-version=1.1.0.0 --windows-description=Aide-Agent-Runtime",
    "build:mac": "bun build --compile dist/runtime.js --outfile dist/aide-agent",
    "build:bin": "node -e \"const{execSync:e}=require('child_process');e(process.platform==='win32'?'bun build --compile dist/runtime.js --outfile dist/aide-agent.exe --windows-icon=../src-tauri/icons/icon.ico --windows-title=Aide-Agent --windows-publisher=Aide --windows-version=1.1.0.0 --windows-description=Aide-Agent-Runtime':'bun build --compile dist/runtime.js --outfile dist/aide-agent',{stdio:'inherit'})\"",
    "dev": "npx tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "docx": "^9.7.1",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "marked": "^18.0.9",
    "pdfjs-dist": "^6.2.108",
    "undici": "^8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.25.0",
    "jszip": "^3.10.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
