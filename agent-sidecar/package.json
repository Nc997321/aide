{
  "name": "agent-sidecar",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/runtime.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/runtime.js --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "build:exe": "bun build --compile dist/runtime.js --outfile dist/aide-agent.exe",
    "dev": "npx tsx src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
