{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 手机/平板/2in1——aide 是生产力工具，大屏形态是重点
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    // 均 system_grant，无需 reason/usedScene：
    //  - INTERNET：WebSocket 连中继
    //  - KEEP_BACKGROUND_RUNNING：Speech Kit TextReader.init 硬性要求（缺则 201）
    //  - GET_NETWORK_INFO：朗读面板音色切换需要感知网络类型
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      }
    ],
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 播报待命：熄屏后 TtsModel 后台播报（textToSpeech isBackStage）需要
        // AUDIO_PLAYBACK 长时任务防进程冻结；TTS 属官方分类「用户可感知的其他
        // 播放任务」，无需接 AVSession。曾声明的 multiDeviceConnection 已回退
        // （系统校验真实分布式链路，~60s 必杀）。
        "backgroundModes": [
          "audioPlayback"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}
